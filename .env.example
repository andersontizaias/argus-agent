# Argus Agent — variáveis de ambiente
# Copie para .env e preencha. Nunca commitar o .env real.

# Chave mestra Fernet para cifrar secrets em repouso (LLM keys, auth de binários).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARGUS_SECRET_KEY=

# Caminho do banco SQLite (default: ~/.argus/argus.db)
ARGUS_DB_PATH=

# Diretório de artefatos de runs (default: ~/.argus/artifacts)
ARGUS_ARTIFACTS_DIR=

# Host/porta do servidor (default: 127.0.0.1:8765)
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8765

# Exige X-API-Key mesmo em bind loopback (default: false)
ARGUS_REQUIRE_API_KEY=false

# Servidor Appium (gerenciado pelo worker; porta base)
APPIUM_BASE_PORT=4723

# AVD Android usado nas runs android (precisa existir no Android Studio /
# Device Manager) e porta do emulador
ARGUS_ANDROID_AVD=Pixel_9a
ARGUS_ANDROID_EMULATOR_PORT=5554

# Simulador iOS usado nas runs ios (precisa existir no Xcode — Window >
# Devices and Simulators)
ARGUS_IOS_DEVICE=iPhone 15
