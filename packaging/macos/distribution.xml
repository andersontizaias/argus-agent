<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Argus Agent</title>
    <organization>com.andersontizaias</organization>
    <!-- currentUserHome (sem enable_localSystem) faz o Installer.app instalar
         no domínio do usuário, sem pedir senha de admin — coerente com o
         pacote não ter payload nenhum (tudo vai pra ~/argus e ~/.argus via
         scripts/install.sh, rodado pelo postinstall). -->
    <domains enable_localSystem="false" enable_currentUserHome="true" enable_anywhere="false"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.andersontizaias.argus-agent.installer"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.andersontizaias.argus-agent.installer" visible="false">
        <pkg-ref id="com.andersontizaias.argus-agent.installer"/>
    </choice>
    <pkg-ref id="com.andersontizaias.argus-agent.installer" version="__WIZARD_VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
